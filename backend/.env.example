PORT=5000
# For local MongoDB: mongodb://localhost:27017/digital-legacy-manager
# For MongoDB Atlas: mongodb+srv://username:password@cluster.mongodb.net/digital-legacy-manager?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/digital-legacy-manager
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRE=7d
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef
SMTP_EMAIL=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_SERVICE=gmail
FRONTEND_URL=http://localhost:3000
NODE_ENV=development
